APP_ENV=development
APP_ADDR=:8080
LOG_LEVEL=debug

DATABASE_URL='postgres://replace-me'
MIGRATIONS_DATABASE_URL='postgres://replace-me'

BFF_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=uxanomalies-api
JWT_AUDIENCE=uxanomalies-bff
JWT_SIGNING_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TTL=24h

MAX_BODY_BYTES=1048576
MAX_MULTIPART_BYTES=20971520
MAX_IMAGE_BYTES=5242880

RATE_LIMIT_BACKEND=memory

STORAGE_BACKEND=gcs
GCP_PROJECT_ID=replace-me
GCS_BUCKET=replace-me
GCS_UPLOAD_PREFIX=anomalies
GCS_SIGNED_URL_TTL=24h

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://uxanomalies.com
